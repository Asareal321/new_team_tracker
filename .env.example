VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (no VITE_ prefix) — used by /api/daily-summary, set this
# in your Vercel project's environment variables, not in the client bundle.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional. Comma-separated emails that get the in-app developer panel
# (cloud animation previews and garden shortcuts), opened with
# Ctrl/Cmd + Shift + D or from the Account page. Leave unset to disable it
# entirely. NOTE: VITE_ variables are inlined into the public client bundle,
# so treat this as a convenience gate, not a security boundary.
VITE_DEV_EMAIL=you@example.com
